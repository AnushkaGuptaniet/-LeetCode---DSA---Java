import java.util.Scanner;
public class InputOutput {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("n = ");
        int n = sc.nextInt();
        printNumber(n);
    }
    public static void printNumber(int n){
        System.out.print("n = " + n);
    }
}

// TC: O(1) , SC: O(1)
