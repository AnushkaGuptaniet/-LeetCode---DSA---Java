    // Approach 3: Mathematical Approach
    public static int whileLoop(int d){
        int first = d;
        if(d == 0){
            first = 10;
        }else{
            first = d;
        }
        int last = first + 49 * 10;
        return (50 * (first + last)) / 2;
    }
