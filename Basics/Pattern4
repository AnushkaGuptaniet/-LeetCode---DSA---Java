public class Pattern3 {
    public static void main(String[] args) {
        int n = 5;
        pattern3(n);
    }
    public static void pattern3(int n){
        for(int i = 1; i <= n; i++){
            for(int j = 1; j <= i; j++){
                System.out.print(i);
            }
            System.out.println();
        }
    }
}
// TC:O(n^2), SC: O(1)
