    // Approach 3 : Recursive Approach
    public static int[] reverseArr(int[] arr, int left, int right){
        int  n = arr.length;
        if(left >= right){
            return arr ;
        }
        int temp = arr[left];
        arr[left] = arr[right];
        arr[right] = temp;
        return reverseArr(arr, left + 1, right - 1);
    }
// TC: O(n), SC: O(n)

